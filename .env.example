# Copy to .env.local for local development. Real values live in Vercel environment variables.
# Never commit real keys.

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://themortgageadvisory.com

# Step 4: chat assistant (server-side only)
ANTHROPIC_API_KEY=
# Only if the API key is organization-level (not created inside a workspace): the workspace ID from the Anthropic
# Console (Settings → Workspaces). Not needed for workspace keys.
ANTHROPIC_WORKSPACE_ID=
# Optional: URL that gets a JSON alert when the chat can't answer (e.g. a Go High Level inbound webhook)
CHAT_ALERT_WEBHOOK_URL=
# Optional: defaults to claude-opus-5. claude-sonnet-5 costs about 60% less.
CHAT_MODEL=

# Phase 2: Go High Level booking API (server-side only)
GHL_PRIVATE_TOKEN=

# Set to 1 to make the placeholder check fail locally like a production build
STRICT_PLACEHOLDERS=
